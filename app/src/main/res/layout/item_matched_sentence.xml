<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- 6-dot drag handle for drag-and-drop sentence reordering. -->
    <ImageView
        android:id="@+id/dragHandle"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:contentDescription="@string/reorder_sentence"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle" />

    <TextView
        android:id="@+id/sentenceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textIsSelectable="true"
        android:textSize="15sp" />

    <!-- Explicit affordance: right arrow opens the single sentence view (no box). -->
    <ImageButton
        android:id="@+id/sentenceViewButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/view_single_sentence"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_forward" />

</LinearLayout>
