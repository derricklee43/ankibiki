<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:textIsSelectable="true"
        android:id="@+id/sentenceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp" />

    <!-- Manual sentence ordering (rank stored on the word entity; unset = date order). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/moveUpButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/move_sentence_up"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="9dp"
        app:icon="@drawable/ic_arrow_up"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/moveDownButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/move_sentence_down"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="9dp"
        app:icon="@drawable/ic_arrow_down"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="18dp" />

    <!-- Explicit affordance: opens the single sentence view (no hidden text taps). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sentenceViewButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/view_single_sentence"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="10dp"
        app:icon="@drawable/ic_open_sentence"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp" />

    <!-- 2026-11-13: per-sentence pencil moved to the sentence view (user UI tweak);
         rows now carry open-in-new + ordering affordances only. -->

</LinearLayout>
