<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Top Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigate_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/detailContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <!-- 1. Horizontally Scrollable Photo Strip -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/matchingPhotosStrip"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:clipToPadding="false" />

            <!-- 2. Target Word on its own line -->
            <TextView
                android:textIsSelectable="true"
                android:id="@+id/targetExpressionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- 3. Three Reveal Rows with compact 表示 Buttons: Kanji (Decomposition Tree), Kana, Meaning -->
            <LinearLayout
                android:id="@+id/kanjiRevealRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="@string/label_kanji"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/kanjiRevealButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_reveal" />

                    <TextView
                        android:textIsSelectable="true"
                        android:id="@+id/kanjiValueText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <com.derricklee.ankidict.DecompositionTreeView
                        android:id="@+id/kanjiDecompositionTree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/kanaRevealRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_kana"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kanaRevealButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_reveal" />

                <TextView
                    android:textIsSelectable="true"
                    android:id="@+id/kanaValueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- v11 user definition + notes. v16 (docs/definition-model-design.md §3.3):
                 the 定義 row is REMOVED — the 意味 row became the merged definition
                 (source chip + pencil + 変更). The row stays in XML, permanently gone,
                 so no binding renames were needed for siblings. -->
            <LinearLayout
                android:id="@+id/userDefinitionRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_user_definition"
                    android:textStyle="bold" />

                <TextView
                    android:textIsSelectable="true"
                    android:id="@+id/userDefinitionValueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/userDefinitionEditButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_edit_content_desc"
                    android:src="@drawable/ic_edit_pencil" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/userNotesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_user_notes"
                    android:textStyle="bold" />

                <TextView
                    android:textIsSelectable="true"
                    android:id="@+id/userNotesValueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/userNotesEditButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_edit_content_desc"
                    android:src="@drawable/ic_edit_pencil" />

            </LinearLayout>

            <!-- v11 folder assignment (user answer: one folder per word; managed in the フォダ tab) -->
            <LinearLayout
                android:id="@+id/folderRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_folder"
                    android:textStyle="bold" />

                <TextView
                    android:textIsSelectable="true"
                    android:id="@+id/folderValueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/folderEditButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_edit_content_desc"
                    android:src="@drawable/ic_folder_small" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/meaningRevealRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <TextView
                    android:textIsSelectable="true"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_meaning"
                    android:textStyle="bold" />

                <!-- v16 merged definition row (docs/definition-model-design.md §3.3):
                     provenance chip — 辞書/選択/ユーザー/名簿 — hidden for blank meanings. -->
                <TextView
                    android:id="@+id/definitionSourceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/meaningRevealButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_reveal" />

                <TextView
                    android:textIsSelectable="true"
                    android:id="@+id/meaningValueText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- v16: pencil on the merged row opens the definition editor
                     (save -> USER, blank save -> revert to dictionary). -->
                <ImageButton
                    android:id="@+id/meaningEditButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_edit_content_desc"
                    android:src="@drawable/ic_edit_pencil" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/meaningPickButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="6dp"
                    android:text="@string/btn_reselect_definition"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 4. Japanese Corpus Frequency -->
            <TextView
                android:textIsSelectable="true"
                android:id="@+id/corpusFrequencyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 5. Original Japanese Sentences (Tap any sentence to amend) -->
            <TextView
                android:textIsSelectable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/matched_sentences_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sentencesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </ScrollView>

    <!-- 6. Bottom Action Buttons: Create/See Anki Card, Mark as Seen, Hide, Archive, Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/ankiCardActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_create_card" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/markSeenButton"
                style="?attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_mark_seen" />

            <Button
                android:id="@+id/hideItemButton"
                style="?attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_hide" />

            <Button
                android:id="@+id/archiveItemButton"
                style="?attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_archive" />

            <Button
                android:id="@+id/deleteOccurrenceButton"
                style="?attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="@string/btn_delete"
                android:textColor="#D32F2F" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
